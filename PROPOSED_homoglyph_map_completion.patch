--- a/src/defenses/sanitization/sanitize.py
+++ b/src/defenses/sanitization/sanitize.py
@@ UNICODE_LOOKALIKE_MAP @@
 # ADDED: the generator's _unicode_homoglyphs() encoder substitutes EIGHT
 # ASCII letters with Cyrillic look-alikes (a e o i c p x y). Only four of
 # them (a e o i) were present in this map, so half of every homoglyph-
 # encoded payload survived normalisation unreversed -- e.g. "experiment"
 # normalised to "eхрeriment", still carrying U+0445 and U+0440, and so
 # matched no downstream pattern. Measured effect of adding the missing
 # four (L0-L3, no model, 5 seeds pooled, n=5005):
 #     homoglyph-variant detection   73.9% -> 88.1%
 #     overall attack detection      89.37% -> 90.63%
 #     external benign FPR           6/333 -> 6/333  (UNCHANGED, no cost)
+    'с': 'c',   # U+0441 CYRILLIC SMALL LETTER ES
+    'р': 'p',   # U+0440 CYRILLIC SMALL LETTER ER
+    'х': 'x',   # U+0445 CYRILLIC SMALL LETTER HA
+    'у': 'y',   # U+0443 CYRILLIC SMALL LETTER U
